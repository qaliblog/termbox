{
  "_comment": "TermBox Asset Manifest - Verified upstream sources with pinned versions",
  "_schema_version": "1.1.0",

  "bootstrap": {
    "description": "Termux bootstrap packages for the TermBox prefix",
    "version": "2026.02.12-r1+apt.android-7",
    "url_pattern": "https://github.com/termux/termux-packages/releases/download/bootstrap-{version}/bootstrap-{arch}.zip",
    "architecture": "multi-arch",
    "compression": "zip",
    "required_for_offline": true,
    "license": "MIT",
    "license_url": "https://github.com/termux/termux-packages/blob/master/LICENSE.txt",
    "source": "https://github.com/termux/termux-packages",
    "variants": {
      "aarch64": {
        "url": "https://github.com/termux/termux-packages/releases/download/bootstrap-2026.02.12-r1%2Bapt.android-7/bootstrap-aarch64.zip",
        "sha256": "ea2aeba8819e517db711f8c32369e89e7c52cee73e07930ff91185e1ab93f4f3",
        "filename": "bootstrap-aarch64.zip",
        "size_estimate_mb": 30
      }
    },
    "destination": "bootstrap/{arch}.zip",
    "extract_to": "bootstrap/"
  },

  "proot-distro": {
    "description": "proot-distro - utility for managing proot distributions",
    "version": "5.8.0",
    "commit": "f832a56f2e8aab659a915600598b5321996aad78",
    "url": "https://github.com/termux/proot-distro/archive/refs/tags/v5.8.0.tar.gz",
    "sha256": null,
    "filename": "proot-distro-5.8.0.tar.gz",
    "architecture": "all",
    "compression": "tar.gz",
    "required_for_offline": true,
    "license": "MIT",
    "license_url": "https://github.com/termux/proot-distro/blob/master/LICENSE",
    "source": "https://github.com/termux/proot-distro",
    "install_method": "copy_source_tree",
    "notes": "proot is already included in the Termux bootstrap. This package provides the distro management scripts."
  },

  "ubuntu": {
    "description": "Ubuntu 24.04 ARM64 rootfs extracted from official Docker OCI image",
    "version": "24.04",
    "docker_image": "arm64v8/ubuntu:24.04",
    "docker_platform": "linux/arm64/v8",
    "install_method": "docker_export",
    "compression": "tar.xz",
    "required_for_offline": true,
    "license": "CC-BY-SA 4.0",
    "license_url": "https://ubuntu.com/legal/intellectual-property-policy",
    "source": "https://hub.docker.com/_/ubuntu",
    "notes": "Built by pulling the official arm64v8/ubuntu:24.04 Docker image and exporting its rootfs. Requires Docker on the build machine."
  },

  "box64": {
    "description": "Box64 - Linux userspace x86_64 emulator for ARM64, built from source for Android",
    "version": "0.4.4",
    "commit": null,
    "source": "https://github.com/ptitSeb/box64",
    "release": "https://github.com/ptitSeb/box64/releases/tag/v0.4.4",
    "build_method": "cmake_android_ndk",
    "cmake_options": {
      "ANDROID": "ON",
      "ARM_DYNAREC": "ON",
      "BAD_SIGNAL": "ON",
      "CMAKE_BUILD_TYPE": "RelWithDebInfo",
      "NOGIT": "ON"
    },
    "target_abi": "arm64-v8a",
    "target_platform": "android-24",
    "required_for_offline": true,
    "license": "MIT",
    "license_url": "https://github.com/ptitSeb/box64/blob/main/LICENSE",
    "notes": "Must be cross-compiled from source using Android NDK. No pre-built Android binary exists upstream."
  },

  "termbox-config": {
    "description": "TermBox default configuration files",
    "version": "0.1.0",
    "url": null,
    "sha256": null,
    "filename": null,
    "architecture": "all",
    "compression": null,
    "required_for_offline": true,
    "license": "MIT",
    "license_url": null,
    "source": "local",
    "destination": "config/",
    "extract_to": "config/"
  }
}
